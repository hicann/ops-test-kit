static uint32_t GetDataTypeSize(DataType dt) {
    switch (dt) {
        case DT_FLOAT:       return 4;
        case DT_FLOAT16:     return 2;
        case DT_BF16:        return 2;
        case DT_INT32:       return 4;
        case DT_INT16:       return 2;
        case DT_INT8:        return 1;
        case DT_UINT8:       return 1;
        case DT_INT64:       return 8;
        case DT_UINT64:      return 8;
        case DT_DOUBLE:      return 8;
        case DT_BOOL:        return 1;
        case DT_FLOAT8_E4M3FN: return 1;
        case DT_FLOAT8_E5M2:  return 1;
        default:             return 1;
    }
}

static int64_t ShapeSize(const vector<int64_t>& shape) {
    int64_t size = 1;
    for (size_t i = 0; i < shape.size(); i++) size *= shape[i];
    return size;
}

